# --- 1HZ50V HMA + Mladen Flow Bot (Raspberry Pi) ---
# Copia este archivo a la Pi como .env y edita los valores.

# Token de API de Deriv (cuenta demo). Si no se define, el bot corre en PAPER.
DERIV_TOKEN=

# Símbolo a operar
DERIV_SYMBOL=1HZ50V

# Stake por contrato (USD)
DERIV_STAKE=10.0

# Duración del contrato en minutos
DERIV_DURATION=1
DERIV_DURATION_UNIT=m

# Parámetros de la estrategia (óptimos del sweep 1HZ50V)
DERIV_HMA_PERIOD=20
DERIV_FLOW_PERIOD=14
DERIV_FLOW_SMOOTH=3
DERIV_FLOW_THRESHOLD=0.0

# Gestión de riesgo
DERIV_STOP_AFTER_LOSSES=5
DERIV_MAX_DAILY_LOSS=50.0

# Logging
DERIV_LOG_LEVEL=INFO
DERIV_LOG_FILE=bot_1hz50v.log

# Modo demo (true = demo/paper, false = real — NO usar en producción sin validar)
DERIV_DEMO=true
